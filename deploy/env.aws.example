# AWS Secrets Manager — JSON body for stellarroute-*/app
# Copy keys into a local secret.json (never commit), then:
#   aws secretsmanager put-secret-value --secret-id <secrets_name> --secret-string file://secret.json
#
# Terraform seeds DATABASE_URL + REDIS_URL on first apply. Update ROUTER + ADMIN before public traffic.
# Full runbook: docs/deployment/aws.md

DATABASE_URL=postgresql://stellarroute:PASSWORD@RDS_HOST:5432/stellarroute
REDIS_URL=redis://REDIS_HOST:6379
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ROUTER_CONTRACT_ADDRESS=CCOKRYC5ROFYFYDATV2Y3A2DRAGY2LJV7D6B327YFIQS2Y2EWII7TVHS
AMM_POOLS=
ADMIN_AUTH_TOKEN=change-me-strong-random
CORS_ALLOWED_ORIGINS=https://www.stellarroute.app,https://stellarroute.app,https://stellarroute-frontend.vercel.app
PUBLIC_GET_ROUTES=/api/v1/quote,/api/v1/pairs,/api/v1/markets,/api/v1/orderbook,/api/v1/routes,/api/v1/price-history,/health
RUST_LOG=info,stellarroute_api=info,stellarroute_indexer=info

# Set in ECS task definition (not Secrets Manager):
# STELLARROUTE_ENV=production
# ENABLE_ADMIN_ROUTES=false
# PORT=8080
