# Example production / Oracle staging env — copy to repo-root `.env.prod` (never commit).
# See deploy/secrets.checklist.md and docs/deployment/oracle-always-free.md.

POSTGRES_USER=stellarroute
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=stellarroute
REDIS_PASSWORD=change-me-strong-random

# Host port published for the API (Cloudflare Tunnel targets http://127.0.0.1:$API_HOST_PORT)
API_HOST_PORT=8080

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# From config/deployments/testnet.json after ./scripts/deploy.sh --network testnet
ROUTER_CONTRACT_ADDRESS=

# Optional comma-separated Aquarius (or other) pool contract IDs to index when
# event discovery is empty / outside RPC retention. Matches config/pools-testnet.json.
AMM_POOLS=

STELLARROUTE_ENV=production
# Comma-separated browser origins (custom domain + Vercel production + previews as needed)
CORS_ALLOWED_ORIGINS=https://www.stellarroute.app,https://stellarroute.app,https://stellarroute-frontend.vercel.app
PUBLIC_GET_ROUTES=/api/v1/quote,/api/v1/pairs,/api/v1/markets,/api/v1/orderbook,/api/v1/routes,/api/v1/price-history,/health
ADMIN_AUTH_TOKEN=change-me-admin-token
ENABLE_ADMIN_ROUTES=false

RUST_LOG=stellarroute=info,warn
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Circle CCTP v2 bridge (default-off; see docs/development/environment-variables.md)
# CCTP_ENABLED=false
# Required when CCTP_ENABLED=true (≥32 random bytes; base64 / hex / base64url):
# CCTP_ACCESS_TOKEN_HMAC_KEY=
# Required when enabled — explicit Sepolia JSON-RPC (no silent rpc.sepolia.org fallback):
# CCTP_SEPOLIA_RPC_URL=
# Optional alias if CCTP_SEPOLIA_RPC_URL is unset:
# SEPOLIA_RPC_URL=
# Optional Soroban RPC override for CCTP probes/builders (else SOROBAN_RPC_URL):
# CCTP_STELLAR_RPC_URL=
# Optional Iris sandbox override (default https://iris-api-sandbox.circle.com):
# CCTP_IRIS_BASE_URL=

# After Cloudflare Tunnel is up, set Vercel production env to the tunnel URL:
#   NEXT_PUBLIC_API_URL=https://api.your-domain
#   NEXT_PUBLIC_API_URL_TESTNET=https://api.your-domain
# And ensure CORS_ALLOWED_ORIGINS includes https://www.stellarroute.app (and apex / Vercel URLs)
