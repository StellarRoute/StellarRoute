# Feature flags
NEXT_PUBLIC_FLAG_ROUTES_BETA=false
NEXT_PUBLIC_FLAG_BATCH_SWAPS=false
NEXT_PUBLIC_FLAG_SWAP_UI_V2=false
# Default production swap path: API prepare → Freighter sign → API submit.
# Security-pinned: remote FLAGS_URL cannot disable this. When false, swaps fail closed.
NEXT_PUBLIC_FLAG_REAL_XDR=true

# Network + API (local development — localhost allowed)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# API root or /api/v1 base; CCTP calls /api/v2 on the same origin (trailing /api/v1 is stripped).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_API_URL_TESTNET=https://api.your-staging-host
# NEXT_PUBLIC_API_URL_MAINNET=https://api.your-mainnet-host

# WalletConnect / Reown Cloud project id (public) — enables EVM QR + mobile wallets on /cross-chain.
# Create at https://cloud.reown.com — without this, only injected browser wallets (MetaMask etc.) work.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Production / Vercel: set a public HTTPS API URL (never localhost).
# STELLARROUTE_ENV=production
